#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Add the signed `enzimos-os` system repository to a Pacman snapshot.

    build-os-repo --reports PATH [--reports PATH ...] --desktop-stage DIR
                  --runtime-layout DIR --release N --signer GNUPGHOME
                  [--passphrase-file FILE] --output OUT

The system repository holds what the enzimOS installation media need beyond
the `enzimos` add-on repository: the installer, recovery and update runtimes,
system policy, replacement services (greetd, keyring, portal), the local AI
packages, and two data packages for the media builder:

  enzimos-iso-desktop         the staged live and installed desktop tree
  enzimos-iso-runtime-layout  the live installer files and runtime layouts

A first delivery larger than the 2 GiB release asset limit is staged: publish
with `--exclude enzimos-recovery-env`, then again without it; the second
snapshot resends only the new package.

Add-on applications go into the system repository only when the build is
newer than the published add-on package. Arch systems using `enzimos-try`
never configure this repository.

OUT receives the active `enzimos` databases from packages.enzim.dev, the new
`enzimos-os` databases and the new packages, ready for
`repo_release.py bundle --published-db OUT/enzimos.db`.
"""
import argparse
import hashlib
import json
import os
import shutil
import subprocess
import tarfile
import tempfile
import urllib.request
from pathlib import Path

from desktop_companion import verify_stage_xwayland

FINGERPRINT = '66CEB56F3018F39D2491A3B24C558611AFC55399'
PUBLISHED = 'https://packages.enzim.dev/enzimos/x86_64/'
DATABASES = ('enzimos.db', 'enzimos.files')
SYSTEM = {
    'enzimos-native-policy', 'enzimos-system-backend', 'enzimos-update-client',
    'enzimos-rust-packages', 'enzimos-rust-installer', 'enzimos-rust-remote-access',
    'enzimos-rust-updates', 'enzimos-rust-recovery-ui',
    'enzimos-keyring', 'enzimos-greetd', 'enzimos-xdg-desktop-portal-hyprland',
    'enzimos-agent-harness', 'enzimos-developer-tools', 'enzimos-remote-access',
    'enzimos-mount', 'enzimos-aft-mtp', 'enzimos-icon-theme', 'enzimos-dev-monitor',
    'enzimos-activity-service', 'enzimos-recovery-env',
    'enzimos-inference-service', 'enzimos-ai-gateway', 'enzimos-dictation', 'enzimos-llama-cpu',
    'enzimos-llama-vulkan', 'enzimos-whisper-cpu', 'enzimos-sherpa-onnx-cpu', 'enzimos-ai-models', 'enzimos-streaming-speech',
}
REQUIRED = SYSTEM - {'enzimos-xdg-desktop-portal-hyprland'}
ADD_ONS = {
    'enzimos-files', 'enzimos-text', 'enzimos-terminal', 'enzimos-store', 'enzimos-task-manager',
    'enzimos-app-permissions', 'enzimos-background-apps', 'enzui-mcp-center', 'enzimos-phone-link',
}
DATA = {'enzimos-iso-desktop': 'desktop', 'enzimos-iso-runtime-layout': 'runtime-layout'}
PREFIX = 'usr/share/enzimos-iso'


def checksum(path):
    with Path(path).open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def package_info(path):
    body = subprocess.run(['bsdtar', '-xOf', str(path), '.PKGINFO'], capture_output=True, text=True,
                          check=True, timeout=60).stdout
    fields = {}
    for line in body.splitlines():
        key, separator, value = line.partition(' = ')
        if separator:
            fields.setdefault(key, []).append(value)
    return fields


def rows(value):
    if isinstance(value, dict):
        if isinstance(value.get('package'), str) and isinstance(value.get('sha256', value.get('package_sha256')), str):
            yield value
        for item in value.values():
            yield from rows(item)
    elif isinstance(value, list):
        for item in value:
            yield from rows(item)


def newer(left, right):
    result = subprocess.run(['vercmp', left, right], capture_output=True, text=True, check=True)
    return int(result.stdout) > 0


def published_versions(directory):
    versions = {}
    with tarfile.open(directory / 'enzimos.db') as archive:
        for member in archive:
            if member.name.endswith('/desc'):
                fields = {}
                for record in archive.extractfile(member).read().decode().strip().split('\n\n'):
                    key, _, value = record.partition('\n')
                    fields[key] = value
                versions[fields['%NAME%']] = fields['%VERSION%']
    return versions


def collect(report_dirs, published, excluded=frozenset()):
    found = {}
    reports = []
    for entry in map(Path, report_dirs):
        reports += sorted(entry.rglob('*.json')) if entry.is_dir() else [entry]
    for report in reports:
        if True:
            try:
                data = json.loads(report.read_text())
            except ValueError:
                continue
            for row in rows(data):
                path = Path(row['package'])
                if not path.is_absolute():
                    path = report.parent / path
                if not path.name.endswith('.pkg.tar.zst') or not path.is_file() or path.is_symlink():
                    continue
                name = package_info(path)['pkgname'][0]
                if name not in SYSTEM | ADD_ONS or name in excluded:
                    continue
                if checksum(path) != row.get('sha256', row.get('package_sha256')):
                    raise SystemExit(f'{path} differs from its build report {report}')
                version = package_info(path)['pkgver'][0]
                if name in found and not newer(version, found[name][1]):
                    continue
                found[name] = (path, version)
    if missing := sorted(REQUIRED - set(found) - excluded):
        raise SystemExit('missing system packages: ' + ', '.join(missing))
    for name in sorted(ADD_ONS & set(found)):
        if name in published and not newer(found[name][1], published[name]):
            del found[name]
    return {name: path for name, (path, _) in found.items()}


def data_package(name, source, release, output):
    """A data package holding SOURCE under /usr/share/enzimos-iso/<kind>."""
    with tempfile.TemporaryDirectory(prefix='enzimos-iso-package-') as temporary:
        root = Path(temporary)
        target = root / PREFIX / DATA[name]
        target.parent.mkdir(parents=True)
        subprocess.run(['cp', '-a', '--no-preserve=ownership', str(source), str(target)], check=True)
        size = sum(p.lstat().st_size for p in root.rglob('*'))
        info = (f'pkgname = {name}\npkgbase = {name}\npkgver = 0.1.0-{release}\n'
                f'pkgdesc = enzimOS installation media input: {DATA[name]}\n'
                'url = https://github.com/enz1m/enzimos-build\n'
                f"builddate = {int(os.environ.get('SOURCE_DATE_EPOCH', '1789344000'))}\n"
                f'packager = enzimOS\nsize = {size}\narch = any\nlicense = MIT\n')
        (root / '.PKGINFO').write_text(info)
        members = ['.PKGINFO', 'usr']
        common = ['--uid', '0', '--gid', '0', '--uname', 'root', '--gname', 'root']
        subprocess.run(['bsdtar', '-czf', '.MTREE', '--format=mtree', *common,
                        '--options=!all,use-set,type,uid,gid,mode,time,size,sha256,link', *members],
                       cwd=root, check=True)
        archive = output / f'{name}-0.1.0-{release}-any.pkg.tar.zst'
        subprocess.run(['bsdtar', '-cf', str(archive), '--zstd', '--options', 'zstd:compression-level=15',
                        *common, '.MTREE', *members], cwd=root, check=True)
    return archive


def fetch_published(output, env):
    keyring = output.parent / (output.name + '.published-key.gpg')
    with keyring.open('wb') as stream:
        subprocess.run(['gpg', '--export', FINGERPRINT], env=env, check=True, stdout=stream)
    try:
        for name in DATABASES:
            for filename in (name, name + '.sig'):
                with urllib.request.urlopen(PUBLISHED + filename, timeout=60) as response:
                    (output / filename).write_bytes(response.read())
            subprocess.run(['gpgv', '--keyring', str(keyring), str(output / (name + '.sig')), str(output / name)],
                           check=True, capture_output=True)
    finally:
        keyring.unlink()


def build(args):
    if args.output.exists():
        raise SystemExit('choose a new output directory')
    verify_stage_xwayland(args.desktop_stage)
    env = dict(os.environ, GNUPGHOME=str(args.signer.resolve()))
    sign = ['gpg', '--batch', '--yes', '--local-user', FINGERPRINT]
    if args.passphrase_file:
        sign += ['--pinentry-mode', 'loopback', '--passphrase-file', str(args.passphrase_file)]
    args.output.mkdir(parents=True)
    fetch_published(args.output, env)
    packages = collect(args.reports, published_versions(args.output), frozenset(args.exclude))
    for name, source in sorted(packages.items()):
        shutil.copyfile(source, args.output / source.name)
        packages[name] = args.output / source.name
    for name, source in (('enzimos-iso-desktop', args.desktop_stage), ('enzimos-iso-runtime-layout', args.runtime_layout)):
        if not (Path(source) / ('usr' if name == 'enzimos-iso-desktop' else 'enzimos-installer/live')).is_dir():
            raise SystemExit(f'{source} is not a {DATA[name]} tree')
        packages[name] = data_package(name, Path(source).resolve(strict=True), args.release, args.output)
    for path in packages.values():
        subprocess.run([*sign, '--detach-sign', '--output', str(path) + '.sig', str(path)], env=env, check=True)
    subprocess.run(['repo-add', '--quiet', '--include-sigs', str(args.output / 'enzimos-os.db.tar.gz'),
                    *sorted(str(p) for p in packages.values())], check=True)
    for name in ('enzimos-os.db', 'enzimos-os.files'):
        archive = args.output / (name + '.tar.gz')
        subprocess.run([*sign, '--detach-sign', '--output', str(archive) + '.sig', str(archive)], env=env, check=True)
        (args.output / (name + '.sig')).symlink_to(archive.name + '.sig')
    print(json.dumps({'repository': str(args.output),
                      'packages': {name: path.name for name, path in sorted(packages.items())}}, indent=2))


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--reports', type=Path, action='append', required=True)
    parser.add_argument('--desktop-stage', type=Path, required=True)
    parser.add_argument('--runtime-layout', type=Path, required=True)
    parser.add_argument('--release', type=int, required=True)
    parser.add_argument('--signer', type=Path, required=True)
    parser.add_argument('--passphrase-file', type=Path)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--exclude', action='append', default=[], metavar='PACKAGE',
                        help='leave a system package out, e.g. to stage a first delivery below the 2 GiB release limit')
    build(parser.parse_args())
