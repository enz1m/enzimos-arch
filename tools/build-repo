#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Assemble the signed `enzimos` pacman repository for Arch-based systems.

    build-repo --reports DIR [--reports DIR ...] --desktop DIR --meta DIR
               --signer GNUPGHOME --output OUT

Collects the component packages named in COMPONENTS from the enzimOS build
reports (build.json / *.json rows with package_name and package), adds the
enzui-desktop and enzimos-greeter packages (tools/build-desktop-package OUTPUT
directory) and the meta-packages
(packaging/, built with makepkg), signs every package and the database with
the package signing key, and writes OUT/enzimos/x86_64 plus the public key as
OUT/enzimos-packages.asc. Serve OUT over HTTPS (or locally for tests, see
test/README.md).
"""
import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import tempfile
from pathlib import Path

FINGERPRINT = '316DD17C64DB52ABEFA9B558AA8B1E969F33214C'
# The enzimOS packages an Arch system may install. Everything that changes the
# system itself (installer, recovery, update client, policies, greetd, portal
# replacement) stays out.
COMPONENTS = {
    'enzimos-files', 'enzimos-text', 'enzimos-task-manager', 'enzimos-terminal', 'enzimos-store',
    'enzimos-app-permissions', 'enzimos-background-apps', 'enzui-mcp-center',
    'enzimos-inference-service', 'enzimos-ai-gateway', 'enzimos-agent-harness', 'enzimos-dictation',
    'enzimos-llama-cpu', 'enzimos-llama-vulkan', 'enzimos-whisper-cpu', 'enzimos-sherpa-onnx-cpu',
    'enzimos-ai-models', 'enzimos-streaming-speech', 'enzimos-phone-link',
}

# A desktop-only repository avoids staging model/runtime packages when testing
# or offering only the extra desktop session. Neither profile replaces services
# belonging to another desktop (notably the system's credential provider).
DESKTOP_COMPONENTS = {
    'enzimos-files', 'enzimos-text', 'enzimos-task-manager', 'enzimos-terminal', 'enzimos-store',
    'enzimos-app-permissions', 'enzimos-background-apps', 'enzui-mcp-center', 'enzimos-phone-link',
}


def rows(value):
    if isinstance(value, dict):
        if 'package_name' in value and 'package' in value:
            yield value
        for item in value.values():
            yield from rows(item)
    elif isinstance(value, list):
        for item in value:
            yield from rows(item)

META_PACKAGES = {'enzimos-desktop', 'enzimos-apps', 'enzimos-ai', 'enzimos-flatpak-remote'}
OPTIONAL_COMPONENTS = {'enzimos-music'}


def checksum(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def package_info(path):
    body = subprocess.run(['bsdtar', '-xOf', str(path), '.PKGINFO'],
                          capture_output=True, text=True, check=True, timeout=20).stdout
    fields = {}
    for line in body.splitlines():
        key, separator, value = line.partition(' = ')
        if separator:
            fields.setdefault(key, []).append(value)
    return fields


def admit_package(name, path):
    fields = package_info(path)
    if fields.get('pkgname') != [name]:
        raise SystemExit(f'{path} does not contain the expected package {name}')
    if fields.get('arch') not in (['x86_64'], ['any']):
        raise SystemExit(f'{name} is not built for x86_64')
    if fields.get('replaces') or fields.get('conflict'):
        raise SystemExit(f'{name} could replace or conflict with installed packages')


def collect(report_dirs, workspace, components=COMPONENTS):
    found = {}
    for directory in report_dirs:
        for report in sorted(Path(directory).glob('*.json')):
            try:
                data = json.loads(report.read_text())
            except ValueError:
                continue
            for row in rows(data):
                name = row['package_name']
                if (name not in components and name not in OPTIONAL_COMPONENTS) or name in found:
                    continue
                path = Path(row['package'])
                if not path.is_absolute():
                    choices = [report.parent / path]
                    if workspace is not None:
                        choices.append(workspace / path)
                    path = next((candidate for candidate in choices if candidate.is_file()), choices[0])
                if not path.is_file():
                    continue
                digest = row.get('sha256')
                if path.is_symlink() or not isinstance(digest, str) or not re.fullmatch(r'[0-9a-f]{64}', digest):
                    raise SystemExit(f'original archive and digest required for {name}')
                if checksum(path) != digest:
                    raise SystemExit(f'{name} differs from its reviewed build report')
                found[name] = (path, digest)
    missing = sorted(components - set(found))
    if missing:
        raise SystemExit('missing component packages: ' + ', '.join(missing))
    return found


def build(args):
    workspace = args.workspace
    packages = collect(args.reports, workspace, DESKTOP_COMPONENTS if args.profile == 'desktop' else COMPONENTS)
    for name in ('enzui-desktop', 'enzimos-greeter'):
        built = sorted((args.desktop / name / 'artifacts').glob(f'{name}-*.pkg.tar.zst'))
        if len(built) != 1:
            raise SystemExit(f'expected one {name} package in {args.desktop / name}')
        packages[name] = (built[0], checksum(built[0]))
    required_meta = META_PACKAGES - ({'enzimos-ai'} if args.profile == 'desktop' else set())
    for meta in sorted(args.meta.glob('*.pkg.tar.zst')):
        name = meta.name.rsplit('-', 3)[0]
        if name not in required_meta:
            continue
        if name in packages:
            raise SystemExit(f'multiple meta-package archives for {name}')
        packages[name] = (meta, checksum(meta))
    if missing := required_meta - packages.keys():
        raise SystemExit('missing meta-packages: ' + ', '.join(sorted(missing)))
    for name, (source, _) in packages.items():
        admit_package(name, source)
    if args.output.exists():
        raise SystemExit('choose a new output directory')
    args.output.parent.mkdir(parents=True, exist_ok=True)
    env = dict(os.environ, GNUPGHOME=str(args.signer.resolve()))
    with tempfile.TemporaryDirectory(prefix='.enzimos-repo-', dir=args.output.parent) as temporary:
        staging = Path(temporary) / 'repository'
        repo = staging / 'enzimos' / 'x86_64'
        repo.mkdir(parents=True)
        for name, (source, digest) in sorted(packages.items()):
            target = repo / source.name
            shutil.copyfile(source, target)
            if checksum(target) != digest:
                raise SystemExit(f'{name} changed while staging')
            subprocess.run(['gpg', '--batch', '--yes', '--local-user', FINGERPRINT, '--detach-sign',
                            '--output', str(target) + '.sig', str(target)], env=env, check=True)
        subprocess.run(['repo-add', '--sign', '--key', FINGERPRINT, '--verify', str(repo / 'enzimos.db.tar.gz'),
                        *sorted(str(p) for p in repo.glob('*.pkg.tar.zst'))], env=env, check=True,
                       stdout=subprocess.DEVNULL)
        with (staging / 'enzimos-packages.asc').open('w') as key:
            subprocess.run(['gpg', '--armor', '--export', FINGERPRINT], env=env, check=True, stdout=key)
        staging.rename(args.output)
    print(json.dumps({'repository': str(args.output / 'enzimos' / 'x86_64'), 'packages': sorted(packages)}, indent=2))


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--profile', choices=('full', 'desktop'), default='full',
                        help='desktop omits the optional AI meta-package and model/runtime packages')
    parser.add_argument('--workspace', type=Path,
                        help='base directory for older workspace-relative build reports')
    parser.add_argument('--reports', type=Path, action='append', required=True)
    parser.add_argument('--desktop', type=Path, required=True)
    parser.add_argument('--meta', type=Path, required=True)
    parser.add_argument('--signer', type=Path, required=True)
    parser.add_argument('--output', type=Path, required=True)
    build(parser.parse_args())
