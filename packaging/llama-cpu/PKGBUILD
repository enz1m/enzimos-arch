# SPDX-License-Identifier: MIT
pkgname=enzimos-llama-cpu
pkgver=0.1.1
pkgrel=1
pkgdesc='enzimOS CPU runtime for on-device text generation'
arch=('x86_64')
url='https://github.com/ggml-org/llama.cpp'
license=('MIT')
depends=('glibc' 'gcc-libs' 'openssl' 'libgomp' 'zlib' 'brotli' 'zstd')
makedepends=('git' 'cmake' 'ninja' 'pkgconf')
options=('!debug' '!lto')
_commit=08c252e221759e0f69e80f0450b295c92d2344e1
source=("llama.cpp::git+${url}.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
    test "$(git -C "$srcdir/llama.cpp" rev-parse HEAD)" = "$_commit"
    cmake -S "$srcdir/llama.cpp" -B "$srcdir/llama-build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=OFF -DGGML_AVX512=OFF \
        -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON '-DCMAKE_INSTALL_RPATH=$ORIGIN' \
        -DGGML_VULKAN=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF \
        -DLLAMA_BUILD_SERVER=ON -DLLAMA_BUILD_TOOLS=ON -DLLAMA_BUILD_UI=OFF \
        -DLLAMA_USE_PREBUILT_UI=OFF
    cmake --build "$srcdir/llama-build" --parallel "${CMAKE_BUILD_PARALLEL_LEVEL:-2}" --target llama-server
}

package() {
    local destination="$pkgdir/usr/lib/enzimos-inference/cpu"
    local bin="$srcdir/llama-build/bin"
    install -Dm755 "$bin/llama-server" "$destination/llama-server"
    cp -a "$bin"/libggml*.so* "$bin"/libllama*.so* "$bin"/libmtmd.so* "$destination/"
    install -Dm644 /dev/null "$destination/supported-architectures/lfm3"
    install -Dm644 "$srcdir/llama.cpp/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    cd "$srcdir/llama.cpp"
    while IFS= read -r -d '' file; do
        install -Dm644 "$file" "$pkgdir/usr/share/licenses/$pkgname/$file"
    done < <(find vendor -type f \( -iname 'license*' -o -iname 'copying*' \) -print0)
}
